[Unit]
Description=Flourish personal finance tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flourish
Group=flourish
WorkingDirectory=/opt/flourish/app
EnvironmentFile=/opt/flourish/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3210
ExecStart=/usr/bin/node /opt/flourish/app/.next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/flourish/data /opt/flourish/backups /opt/flourish/app/.next/cache

[Install]
WantedBy=multi-user.target
